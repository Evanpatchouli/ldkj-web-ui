{
  "name": "@ldkj/web-ui",
  "version": "0.8.1",
  "private": false,
  "author": "xfwang <wangxiaofeng@xjldkj.com>",
  "description": "React component library built with shadcn-ui patterns and VitePress docs.",
  "keywords": [
    "react",
    "web-ui",
    "component-library",
    "shadcn-ui",
    "vitepress"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "icons:gen": "node ./scripts/generate-material-symbol-loaders.mjs",
    "build": "npm run build:lib && npm run build:types && npm run prepare:package && npm run build:docs",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "build:docs": "vitepress build docs",
    "prepare:package": "node ./scripts/prepare-package.js",
    "preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist docs/.vitepress/dist",
    "update:v": "node ./scripts/update-version.js",
    "add": "pnpm dlx shadcn@latest add"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/serialize": "^1.3.3",
    "@material-symbols/svg-400": "^0.44.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "inquirer": "^8.2.7",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitepress": "^1.6.3",
    "vue": "^3.3.4"
  }
}
